# ============================================================
# MediGraph AI — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.pyo

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Raw & large datasets (never commit) ---
data/raw/
data/processed/*.large*
data/processed/kg*.csv
!data/processed/nodes.csv
!data/processed/edges.csv
!data/processed/node_mapping.json
!data/processed/relation_mapping.json
# Allow sample data
!data/sample/

# --- Artifacts (model weights, predictions, metrics) ---
artifacts/checkpoints/*.pt
artifacts/checkpoints/*.pth
artifacts/predictions/*.json
artifacts/predictions/*.csv
artifacts/metrics/*.json
artifacts/visualizations/*.html
# Keep primary benchmark metric reports
!artifacts/metrics/metrics.json
!artifacts/metrics/baseline_comparison.json
!artifacts/metrics/eval_metrics.json
# Keep placeholder files
!artifacts/checkpoints/.gitkeep
!artifacts/predictions/.gitkeep
!artifacts/metrics/.gitkeep
!artifacts/visualizations/.gitkeep


# --- OS ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log
logs/

# --- Coverage & testing ---
.coverage
htmlcov/
.pytest_cache/
.tox/

# --- Mypy / type checking ---
.mypy_cache/
.dmypy.json

# --- Secrets & credentials ---
*.env
secrets.yaml
credentials.json

